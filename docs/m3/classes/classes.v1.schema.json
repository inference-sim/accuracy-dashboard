{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "classes.json (format classes-1)",
  "description": "The classes page's data (orchestrator/build_classes.py): one entry per class of points, each with its own counts, grade mix and accuracy by grade. The regular InferenceX class is read from summary.json; the reconstructed-recipe class and the configiq class are read from the derived files under data/supplemental/classes/. A figure over fewer than 10 points is the string \"too few points\" (COV-11).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "generated_at", "snapshot_id", "classes"],
  "properties": {
    "format": {"const": "classes-1"},
    "generated_at": {"type": "string"},
    "snapshot_id": {"type": ["string", "null"]},
    "classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/class"}}
  },
  "definitions": {
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "mape", "signed_median"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "mape": {"oneOf": [{"type": "number"}, {"const": "too few points"}]},
        "signed_median": {"oneOf": [{"type": "number"}, {"const": "too few points"}, {"type": "null"}]}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "scored", "refused", "failed", "withheld"],
      "properties": {
        "points": {"type": "integer", "minimum": 0}, "scored": {"type": "integer", "minimum": 0},
        "refused": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0},
        "withheld": {"type": "integer", "minimum": 0}
      }
    },
    "class": {
      "type": "object",
      "required": ["id", "label", "kind", "interim", "note", "counts", "grades", "accuracy_by_grade", "refusals", "substitutions", "provenance"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"},
        "kind": {"enum": ["regular", "reconstructed", "provisional"]},
        "interim": {"type": "boolean", "description": "true while the file is from a census that is not the final one"},
        "anchor": {"type": "boolean", "description": "true for an anchor-only source (configiq, D9): every unit is an anchor unit. A fact separate from kind: kind provisional says the class is outside the headline (COV-7)"},
        "note": {"type": "string"},
        "counts": {"$ref": "#/definitions/counts"},
        "grades": {
          "type": "object", "additionalProperties": false, "required": ["G1", "G2", "G3", "G4", "G5"],
          "properties": {"G1": {"type": "integer"}, "G2": {"type": "integer"}, "G3": {"type": "integer"}, "G4": {"type": "integer"}, "G5": {"type": "integer"}}
        },
        "accuracy_by_grade": {
          "type": "object", "additionalProperties": false, "required": ["G1", "G2", "G3", "G4"],
          "patternProperties": {"^G[1-4]$": {"type": "object", "minProperties": 2,
            "properties": {"ttft": {"$ref": "#/definitions/figure"}, "tpot": {"$ref": "#/definitions/figure"}, "itl": {"$ref": "#/definitions/figure"}},
            "additionalProperties": false}}
        },
        "refusals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "subject", "points"],
          "properties": {"code": {"type": "string"}, "subject": {"type": "string"}, "points": {"type": "integer"}}}},
        "substitutions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "subject", "detail", "points"],
          "properties": {"kind": {"type": "string"}, "subject": {"type": "string"}, "detail": {"type": "string"}, "points": {"type": "integer"}}}},
        "engines": {"type": "array", "items": {"type": "object"}},
        "provenance": {"type": "object", "required": ["command", "heads", "pulled_at"]}
      }
    }
  }
}
