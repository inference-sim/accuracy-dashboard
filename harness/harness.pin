# The Go release the harness image installs to build a simulator (the one inference-sim's go.mod
# names), and the sha256 of its linux-amd64 tarball from go.dev. The only place the dashboard states it.
GO_VERSION=1.27.2
GO_SHA256=ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5

# The inference-sim commit the compatibility job builds and runs the real-simulator tests against
# (checks.yml, job `simulator`). TEMPORARY: the head of inference-sim/inference-sim#2090 until it
# is released; then the v0.16.0 tag's commit.
SIM_COMMIT=3b84e0878e4c63f47d202de2ff0471ee7722a4cc
