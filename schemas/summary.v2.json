{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inference-sim.github.io/accuracy-dashboard/schemas/summary.v2.json",
  "title": "BLIS Accuracy Dashboard summary.json (v2)",
  "description": "summary.json v2 (Discussion #28): v1 plus per-point fidelity provenance, a per-point measurement date and point id, a top-level not_scored list, and API-ingest provenance. Built from the extractor's contract files (orchestrator/ingest/CONTRACT.md). v1 stays the format the nightly publishes until the switch-over.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "provenance",
    "coverage",
    "metrics",
    "totals",
    "matrix",
    "scope",
    "not_scored"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "snapshot_id": {
      "type": "string",
      "description": "e.g. 2026-10-23_blis-v0.12.0_ix-api-2026-10-23 (date of the run, BLIS release, 'api-' + pull date)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_blis-.+_ix-.+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blis",
        "ground_truth",
        "evaluator_commit",
        "scorer",
        "ingest",
        "vllm_ref",
        "vllm_max_distance",
        "policy_sha256",
        "pulled_at"
      ],
      "properties": {
        "blis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "commit_sha",
            "catalog",
            "registry",
            "extractor_version"
          ],
          "properties": {
            "release": {
              "type": "string",
              "description": "CI-resolved latest stable tag; never main/pre-release"
            },
            "commit_sha": {
              "type": "string"
            },
            "catalog": {
              "type": "string",
              "description": "derived from the release's installation.md"
            },
            "registry": {
              "type": "string",
              "description": "derived from the release's installation.md"
            },
            "extractor_version": {
              "type": "string",
              "description": "blis-latency-kernel@<go.mod-pinned tag>"
            }
          }
        },
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "release_tag",
            "measurement_sha256"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "source_url": {
              "type": "string"
            },
            "release_tag": {
              "type": "string",
              "description": "For API ingest: 'api-<pull date>'"
            },
            "measurement_date_through": {
              "type": [
                "string",
                "null"
              ]
            },
            "measurement_sha256": {
              "type": "string",
              "description": "sha256 of the frozen pull manifest (every point's frozen inputs and their sha256s)"
            }
          }
        },
        "evaluator_commit": {
          "type": "string"
        },
        "scorer": {
          "const": "signedprobe"
        },
        "vllm_filter": {
          "type": [
            "object",
            "null"
          ],
          "description": "the latest-N vLLM-version filter applied before scoring (RFC discussion #2 point 2); null if unfiltered",
          "additionalProperties": true
        },
        "ingest": {
          "const": "api",
          "description": "Which ingest produced this snapshot. v1 snapshots are the db-dump pipeline; Compare refuses to diff across ingests."
        },
        "vllm_ref": {
          "type": "string",
          "description": "VLLM_REF: the vLLM release distance is measured from"
        },
        "vllm_max_distance": {
          "type": "integer",
          "minimum": 0,
          "description": "VLLM_MAX_DISTANCE: symmetric limit in commits"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of orchestrator/vllm_arg_policy.yaml as used"
        },
        "pulled_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the API pull was frozen"
        },
        "corpus": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "dataset",
            "revision",
            "sha256"
          ],
          "properties": {
            "dataset": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scored",
        "not_scored",
        "multinode_hidden",
        "failed",
        "not_scored_reasons"
      ],
      "properties": {
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "not_scored": {
          "type": "integer",
          "minimum": 0
        },
        "multinode_hidden": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "repeat_runs_folded": {
          "type": "integer",
          "minimum": 0,
          "description": "v2: InferenceX runs folded into another point as a repeat of it (scored = matrix points; scored + repeat_runs_folded + not_scored = the pull's rows)."
        },
        "measured_excluded": {
          "type": "integer",
          "minimum": 0,
          "description": "measured-data artefacts surfaced in known_artefacts; counted, NOT dropped from scoring"
        },
        "not_scored_reasons": {
          "type": "object",
          "description": "breakdown of not_scored; keys are reason slugs (e.g. no_acceptance_rate, model_not_in_catalog, hardware_not_in_catalog, engine_not_modeled)",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "known_artefacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "noted for the reader; NOT filtered out of scoring (RFC: no quality exclusions in v0.1.0)"
    },
    "metrics": {
      "type": "array",
      "items": {
        "enum": [
          "ttft",
          "tpot"
        ]
      },
      "description": "v0.1.0 set only; E2E/tail/throughput are NOT keys anywhere in this schema"
    },
    "metricscore_comparison": {
      "type": [
        "object",
        "null"
      ],
      "description": "LOGGED, never gated (RFC A6/§4.4). The expected gap = three edge-sets' point counts.",
      "additionalProperties": true
    },
    "totals": {
      "$ref": "#/definitions/metricBlockPair"
    },
    "matrix": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/modelNode"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "multinode": {
          "type": "string"
        },
        "measured_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vllm_version_filter": {
          "type": "string"
        }
      }
    },
    "not_scored": {
      "type": "array",
      "description": "Points InferenceX measured that this run did not score. Never rendered; counted in coverage.not_scored_reasons.",
      "items": {
        "$ref": "#/definitions/notScoredPoint"
      }
    }
  },
  "definitions": {
    "mapeShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttft": {
          "type": [
            "number",
            "null"
          ]
        },
        "tpot": {
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metricBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mape",
        "shape"
      ],
      "properties": {
        "mape": {
          "$ref": "#/definitions/mapeShape"
        },
        "shape": {
          "$ref": "#/definitions/mapeShape"
        },
        "noise_floor_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "metricBlockPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_or_resolved",
        "all"
      ],
      "properties": {
        "measured_or_resolved": {
          "$ref": "#/definitions/metricBlock"
        },
        "all": {
          "$ref": "#/definitions/metricBlock"
        }
      }
    },
    "coverageCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scored",
        "total"
      ],
      "properties": {
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modelNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "model",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "model"
        },
        "model": {
          "type": "string",
          "description": "id from server log, NOT display name (D7)"
        },
        "display_name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "vllm_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/workloadNode"
          }
        }
      }
    },
    "workloadNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "label",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "workload"
        },
        "label": {
          "type": "string"
        },
        "isl": {
          "type": [
            "integer",
            "null"
          ]
        },
        "osl": {
          "type": [
            "integer",
            "null"
          ]
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/gpuNode"
          }
        }
      }
    },
    "gpuNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "label",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "gpu"
        },
        "label": {
          "type": "string"
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/topologyNode"
          }
        }
      }
    },
    "topologyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "topology"
        },
        "framework": {
          "type": "string"
        },
        "engine_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_multinode": {
          "type": "boolean"
        },
        "parallelism": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "serving": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointNode"
          }
        }
      }
    },
    "pointNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "concurrency",
        "tier",
        "point_id",
        "measured_date",
        "sweep_id",
        "fidelity"
      ],
      "properties": {
        "level": {
          "const": "point"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "tier": {
          "enum": [
            "measured_or_resolved",
            "all"
          ]
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "predicted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "error_pct": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "shape": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "ttft": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "shape_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "point_id": {
          "$ref": "#/definitions/pointId"
        },
        "measured_date": {
          "$ref": "#/definitions/isoDate"
        },
        "sweep_id": {
          "description": "The measured curve the point's trend (shape) is computed in (the contract's facets sweep_id, or several joined when repeat runs were folded). A deployment row holds one point per concurrency per sweep.",
          "type": "string",
          "minLength": 1
        },
        "repeats": {
          "description": "Present when InferenceX ran this measurement more than once with identical BLIS inputs (same deployment, concurrency and day): every run, with its own measured value. The point's `measured` is their mean and `point_id` the smallest run id.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point_id", "measured"],
            "properties": {
              "point_id": {"$ref": "#/definitions/pointId"},
              "measured": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"ttft_ms": {"type": ["number", "null"]}, "tpot_ms": {"type": ["number", "null"]}}
              }
            }
          }
        },
        "fidelity": {
          "$ref": "https://inference-sim.github.io/accuracy-dashboard/orchestrator/ingest/fidelity.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fidelity": {
                "properties": {
                  "status": {
                    "const": "approximate"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "fidelity"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": "all"
              }
            }
          },
          "else": {
            "properties": {
              "tier": {
                "const": "measured_or_resolved"
              }
            }
          }
        },
        {
          "properties": {
            "fidelity": {
              "properties": {
                "status": {
                  "enum": [
                    "exact",
                    "approximate"
                  ]
                },
                "args": {
                  "items": {
                    "properties": {
                      "match": {
                        "not": {
                          "enum": [
                            "differs",
                            "absent_in_blis",
                            "unreadable",
                            "conflict"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pointId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the point's canonical identity (orchestrator/ingest/CONTRACT.md)"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notScoredPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "identity",
        "measured_date",
        "model",
        "hardware",
        "precision",
        "framework",
        "benchmark_type",
        "conc",
        "reasons"
      ],
      "properties": {
        "point_id": {
          "$ref": "#/definitions/pointId"
        },
        "measured_date": {
          "$ref": "#/definitions/isoDate"
        },
        "model": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "benchmark_type": {
          "enum": [
            "single_turn",
            "agentic_traces"
          ]
        },
        "conc": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://inference-sim.github.io/accuracy-dashboard/orchestrator/ingest/fidelity.schema.json#/definitions/reason"
          }
        },
        "identity": {
          "$ref": "#/definitions/pointIdentity"
        },
        "notes": {
          "description": "Optional, sorted by reason, one per reason at most; each names one of this point's reasons.",
          "type": "array",
          "items": {
            "$ref": "https://inference-sim.github.io/accuracy-dashboard/orchestrator/ingest/fidelity.schema.json#/definitions/note"
          }
        }
      }
    },
    "pointIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "The point's identity in InferenceX's own terms; point_id is the sha256 of its canonical JSON (orchestrator/ingest/CONTRACT.md).",
      "required": [
        "model",
        "hardware",
        "precision",
        "framework",
        "benchmark_type",
        "recipe",
        "conc",
        "measured_date"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "benchmark_type": {
          "enum": [
            "single_turn",
            "agentic_traces"
          ]
        },
        "recipe": {
          "type": "string"
        },
        "conc": {
          "type": "integer",
          "minimum": 1
        },
        "measured_date": {
          "$ref": "#/definitions/isoDate"
        }
      }
    }
  }
}
