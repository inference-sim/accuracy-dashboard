{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inference-sim.github.io/accuracy-dashboard/schemas/summary.v3.json",
  "title": "summary.json v3",
  "description": "summary.json v3 (design §11.3 to §11.6): every point has one closeness grade, G1 to G5, computed from data. The headline covers every graded point, G1 to G4, beside each grade's share and accuracy, every figure with its point count (COV-11); coverage is split by engine, engine release, chip and grade (COV-7); G5 points are listed with their reasons, failed points apart. Built by orchestrator/build_summary_v2.py from the contract (orchestrator/ingest/CONTRACT.md). Published v2 snapshots keep schemas/summary.v2.json (COV-8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "provenance",
    "coverage",
    "metrics",
    "totals",
    "matrix",
    "scope",
    "not_scored",
    "headline",
    "min_points",
    "backlog",
    "failed"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "snapshot_id": {
      "type": "string",
      "description": "e.g. 2026-10-23_blis-v0.12.0_ix-api-2026-10-23 (date of the run, BLIS release, 'api-' + pull date)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_blis-.+_ix-.+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blis",
        "ground_truth",
        "evaluator_commit",
        "scorer",
        "ingest",
        "vllm_ref",
        "vllm_max_distance",
        "fields_sha256",
        "pulled_at",
        "engine",
        "simulator",
        "harness_digest",
        "experimental",
        "units"
      ],
      "properties": {
        "blis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "commit_sha",
            "catalog",
            "registry",
            "extractor_version"
          ],
          "properties": {
            "release": {
              "type": "string",
              "description": "CI-resolved latest stable tag; never main/pre-release"
            },
            "commit_sha": {
              "type": "string"
            },
            "catalog": {
              "type": "string",
              "description": "derived from the release's installation.md"
            },
            "registry": {
              "type": "string",
              "description": "derived from the release's installation.md"
            },
            "extractor_version": {
              "type": "string",
              "description": "blis-latency-kernel@<go.mod-pinned tag>"
            }
          }
        },
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "release_tag",
            "measurement_sha256"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "source_url": {
              "type": "string"
            },
            "release_tag": {
              "type": "string",
              "description": "For API ingest: 'api-<pull date>'"
            },
            "measurement_date_through": {
              "type": [
                "string",
                "null"
              ]
            },
            "measurement_sha256": {
              "type": "string",
              "description": "sha256 of the frozen pull manifest (every point's frozen inputs and their sha256s). On an IX-only merge this is the newest (delta) pull's manifest, which does not cover the carried-over prior points; a whole-window manifest exists only on a seed or BLIS-release rebuild."
            }
          }
        },
        "evaluator_commit": {
          "type": "string"
        },
        "scorer": {
          "const": "orchestrator/ingest/score.py"
        },
        "vllm_filter": {
          "type": [
            "object",
            "null"
          ],
          "description": "the latest-N vLLM-version filter applied before scoring (RFC discussion #2 point 2); null if unfiltered",
          "additionalProperties": true
        },
        "ingest": {
          "const": "api",
          "description": "Which ingest produced this snapshot. v1 snapshots are the db-dump pipeline; Compare refuses to diff across ingests."
        },
        "vllm_ref": {
          "type": "string",
          "description": "VLLM_REF: the vLLM release distance is measured from"
        },
        "vllm_max_distance": {
          "type": "integer",
          "minimum": 0,
          "description": "VLLM_MAX_DISTANCE: symmetric limit in commits"
        },
        "pulled_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the API pull was frozen"
        },
        "corpora": {
          "description": "Each AgentX corpus the run could replay, by the date-pinned alias a run's client records, with the catalog replay workload that pins it by revision and full sha256 (X12, D3). Each agentic point is replayed with its own alias's entry (COV-12).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "workload",
              "dataset",
              "revision",
              "sha256"
            ],
            "properties": {
              "alias": {
                "type": "string"
              },
              "workload": {
                "type": "string"
              },
              "dataset": {
                "type": "string"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "engine": {
          "description": "The engine release the scoring simulator runs (stack.json, LIF-6); every point is scored on it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "vllm"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fields_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the engine's fields.json the scorer read (design §11.1): the field statuses and estimation rules every grade rests on."
        },
        "simulator": {
          "$ref": "https://inference-sim.github.io/accuracy-dashboard/schemas/fidelity.v3.json#/definitions/simulator",
          "description": "The one simulator build that scored every point, and the engine release it runs (COV-6)."
        },
        "harness_digest": {
          "description": "The digest of the harness image that produced every figure (design §11.7, X8), or unreleased.",
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64}|unreleased)$"
        },
        "experimental": {
          "description": "True unless the simulator build is a release tag and its data is released (design §11.7, X8): an experimental figure is never published as BLIS's accuracy.",
          "type": "boolean"
        },
        "units": {
          "description": "The ledger units the run was asked to score (cli.py score --units): the file's sha256, how many it names, and those the pull did not hold; null when the run scored every point of the pull.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "count",
                "not_in_pull"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "not_in_pull": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "coverage": {
      "description": "Graded points over all points (anchor units), by engine, engine release, chip and grade, with the records the ledger left out (COV-7). points = graded + not_scored + failed (COV-1).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "graded",
        "not_scored",
        "failed",
        "share_graded",
        "left_out_records",
        "repeat_runs_folded",
        "by_engine",
        "by_engine_release",
        "by_chip",
        "by_grade",
        "g5_reasons"
      ],
      "properties": {
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "graded": {
          "type": "integer",
          "minimum": 0
        },
        "not_scored": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Points whose scoring failed at a runner limit (CONTRACT.md, Failed points); never graded."
        },
        "share_graded": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "left_out_records": {
          "type": "integer",
          "minimum": 0
        },
        "repeat_runs_folded": {
          "type": "integer",
          "minimum": 0,
          "description": "Graded points shown in the matrix as a repeat of another (merge_repeats); they count in the headline and coverage."
        },
        "by_engine": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/coverageRow"
          }
        },
        "by_engine_release": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/coverageRow"
          }
        },
        "by_chip": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/coverageRow"
          }
        },
        "by_grade": {
          "$ref": "#/definitions/gradeCounts"
        },
        "g5_reasons": {
          "description": "G5 points by the code of their first reason.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "known_artefacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "noted for the reader; NOT filtered out of scoring (RFC: no quality exclusions in v0.1.0)"
    },
    "metrics": {
      "type": "array",
      "items": {
        "enum": [
          "ttft",
          "tpot"
        ]
      },
      "description": "v0.1.0 set only; E2E/tail/throughput are NOT keys anywhere in this schema"
    },
    "metricscore_comparison": {
      "type": [
        "object",
        "null"
      ],
      "description": "LOGGED, never gated (RFC A6/§4.4). The expected gap = three edge-sets' point counts.",
      "additionalProperties": true
    },
    "totals": {
      "$ref": "#/definitions/metricBlockPair"
    },
    "matrix": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/modelNode"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measured_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vllm_version_filter": {
          "type": "string"
        }
      }
    },
    "not_scored": {
      "type": "array",
      "description": "G5 points, with every reason found (design §11.4). Never rendered as figures; counted in coverage.",
      "items": {
        "$ref": "https://inference-sim.github.io/accuracy-dashboard/schemas/fidelity.v3.json#/definitions/notScored"
      }
    },
    "min_points": {
      "description": "The smallest number of points a published figure may cover (COV-11).",
      "const": 10
    },
    "headline": {
      "description": "The headline accuracy over every graded point, G1 to G4, and each grade's share of them and own accuracy (COV-11). Mean absolute percentage error of each point's predicted mean against its measured mean.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "graded",
        "not_scored",
        "headline",
        "grades"
      ],
      "properties": {
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "graded": {
          "type": "integer",
          "minimum": 0
        },
        "not_scored": {
          "type": "integer",
          "minimum": 0
        },
        "headline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ttft",
            "tpot"
          ],
          "properties": {
            "ttft": {
              "$ref": "#/definitions/figure"
            },
            "tpot": {
              "$ref": "#/definitions/figure"
            }
          }
        },
        "grades": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "G1",
            "G2",
            "G3",
            "G4"
          ],
          "properties": {
            "G1": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "points",
                "share",
                "ttft",
                "tpot"
              ],
              "properties": {
                "points": {
                  "type": "integer",
                  "minimum": 0
                },
                "share": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "ttft": {
                  "$ref": "#/definitions/figure"
                },
                "tpot": {
                  "$ref": "#/definitions/figure"
                }
              }
            },
            "G2": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "points",
                "share",
                "ttft",
                "tpot"
              ],
              "properties": {
                "points": {
                  "type": "integer",
                  "minimum": 0
                },
                "share": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "ttft": {
                  "$ref": "#/definitions/figure"
                },
                "tpot": {
                  "$ref": "#/definitions/figure"
                }
              }
            },
            "G3": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "points",
                "share",
                "ttft",
                "tpot"
              ],
              "properties": {
                "points": {
                  "type": "integer",
                  "minimum": 0
                },
                "share": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "ttft": {
                  "$ref": "#/definitions/figure"
                },
                "tpot": {
                  "$ref": "#/definitions/figure"
                }
              }
            },
            "G4": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "points",
                "share",
                "ttft",
                "tpot"
              ],
              "properties": {
                "points": {
                  "type": "integer",
                  "minimum": 0
                },
                "share": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "ttft": {
                  "$ref": "#/definitions/figure"
                },
                "tpot": {
                  "$ref": "#/definitions/figure"
                }
              }
            }
          }
        }
      }
    },
    "backlog": {
      "description": "The ten most common reasons a point is not G1, over every engine: each G5 reason and each substitution, counted once per point (design §11.6). The whole ranked backlog is published beside summary.json.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top"
      ],
      "properties": {
        "top": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "points"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "failed": {
      "type": "array",
      "description": "Points whose scoring failed at a runner limit. Never graded.",
      "items": {
        "$ref": "https://inference-sim.github.io/accuracy-dashboard/schemas/fidelity.v3.json#/definitions/failed"
      }
    }
  },
  "definitions": {
    "mapeShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttft": {
          "type": [
            "number",
            "null"
          ]
        },
        "tpot": {
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metricBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mape",
        "shape"
      ],
      "properties": {
        "mape": {
          "$ref": "#/definitions/mapeShape"
        },
        "shape": {
          "$ref": "#/definitions/mapeShape"
        },
        "noise_floor_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "metricBlockPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_or_resolved",
        "all"
      ],
      "properties": {
        "measured_or_resolved": {
          "$ref": "#/definitions/metricBlock"
        },
        "all": {
          "$ref": "#/definitions/metricBlock"
        }
      }
    },
    "coverageCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scored",
        "total"
      ],
      "properties": {
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modelNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "model",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "model"
        },
        "model": {
          "type": "string",
          "description": "id from server log, NOT display name (D7)"
        },
        "display_name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "vllm_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/workloadNode"
          }
        }
      }
    },
    "workloadNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "label",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "workload"
        },
        "label": {
          "type": "string"
        },
        "isl": {
          "type": [
            "integer",
            "null"
          ]
        },
        "osl": {
          "type": [
            "integer",
            "null"
          ]
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/gpuNode"
          }
        }
      }
    },
    "gpuNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "label",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "gpu"
        },
        "label": {
          "type": "string"
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/topologyNode"
          }
        }
      }
    },
    "topologyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "coverage",
        "metrics",
        "rows"
      ],
      "properties": {
        "level": {
          "const": "topology"
        },
        "framework": {
          "type": "string"
        },
        "engine_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_multinode": {
          "type": "boolean"
        },
        "parallelism": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "serving": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/definitions/coverageCount"
        },
        "metrics": {
          "$ref": "#/definitions/metricBlockPair"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pointNode"
          }
        }
      }
    },
    "pointNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "concurrency",
        "tier",
        "point_id",
        "identity",
        "measured_date",
        "sweep_id",
        "fidelity"
      ],
      "properties": {
        "level": {
          "const": "point"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "tier": {
          "description": "G1 points are the strict tier, measured_or_resolved; G2 to G4 points are in all only. Derived from the grade.",
          "enum": [
            "measured_or_resolved",
            "all"
          ]
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "predicted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "error_pct": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "shape": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "ttft": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "shape_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "point_id": {
          "$ref": "#/definitions/pointId"
        },
        "identity": {
          "$ref": "#/definitions/unitIdentity"
        },
        "measured_date": {
          "$ref": "#/definitions/isoDate"
        },
        "sweep_id": {
          "description": "The measured curve the point's trend (shape) is computed in (the contract's facets sweep_id, or several joined when repeat runs were folded). A deployment row holds one point per concurrency per sweep.",
          "type": "string",
          "minLength": 1
        },
        "repeats": {
          "description": "Present when InferenceX ran this measurement more than once with identical BLIS inputs (same deployment, concurrency and day): every run, with its own measured value. The point's `measured` is their mean and `point_id` the smallest run id.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "point_id",
              "identity",
              "measured"
            ],
            "properties": {
              "point_id": {
                "$ref": "#/definitions/pointId"
              },
              "identity": {
                "$ref": "#/definitions/unitIdentity"
              },
              "measured": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ttft_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "tpot_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "fidelity": {
          "$ref": "https://inference-sim.github.io/accuracy-dashboard/schemas/fidelity.v3.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fidelity": {
                "properties": {
                  "grade": {
                    "const": "G1"
                  }
                },
                "required": [
                  "grade"
                ]
              }
            },
            "required": [
              "fidelity"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": "measured_or_resolved"
              }
            }
          },
          "else": {
            "properties": {
              "tier": {
                "const": "all"
              }
            }
          }
        },
        {
          "properties": {
            "fidelity": {
              "properties": {
                "args": {
                  "items": {
                    "properties": {
                      "match": {
                        "not": {
                          "enum": [
                            "differs",
                            "absent_in_blis",
                            "unreadable",
                            "conflict"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pointId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the point's canonical identity (orchestrator/ingest/CONTRACT.md)"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "unitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "The point's ledger unit identity (design §10.2): the source plus ten InferenceX fields. point_id is the sha256 of its canonical JSON, which is the ledger's unit_id (orchestrator/ingest/CONTRACT.md).",
      "required": [
        "source",
        "model",
        "hardware",
        "precision",
        "framework",
        "benchmark_type",
        "configuration_hash",
        "recipe_fingerprint",
        "conc",
        "measured_date",
        "benchmark_run"
      ],
      "properties": {
        "source": {
          "const": "inferencex"
        },
        "model": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "benchmark_type": {
          "enum": [
            "single_turn",
            "agentic_traces"
          ]
        },
        "configuration_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipe_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "conc": {
          "type": "integer",
          "minimum": 1
        },
        "measured_date": {
          "$ref": "#/definitions/isoDate"
        },
        "benchmark_run": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "figure": {
      "description": "One published accuracy figure and the number of points it covers. Under min_points it is the string 'too few points', never a number (COV-11).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mape",
        "n"
      ],
      "properties": {
        "mape": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "const": "too few points"
            }
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "mape": {
            "type": "number"
          }
        }
      },
      "then": {
        "properties": {
          "n": {
            "minimum": 10
          }
        }
      },
      "else": {
        "properties": {
          "n": {
            "maximum": 9
          }
        }
      }
    },
    "gradeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ],
      "properties": {
        "G1": {
          "type": "integer",
          "minimum": 0
        },
        "G2": {
          "type": "integer",
          "minimum": 0
        },
        "G3": {
          "type": "integer",
          "minimum": 0
        },
        "G4": {
          "type": "integer",
          "minimum": 0
        },
        "G5": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "graded",
        "grades"
      ],
      "properties": {
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "graded": {
          "type": "integer",
          "minimum": 0
        },
        "grades": {
          "$ref": "#/definitions/gradeCounts"
        }
      }
    }
  }
}
