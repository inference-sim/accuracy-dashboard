{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inference-sim.github.io/accuracy-dashboard/schemas/fidelity.v3.json",
  "title": "Per-point fidelity record, with its grade (design §11.3)",
  "description": "What a measured InferenceX run did versus what BLIS was given, for one point, and the point's closeness grade. Written by the scorer (orchestrator/ingest/score.py) into the contract's fidelity.jsonl, and embedded in summary.json v3 pointNode.fidelity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grade",
    "substitutions",
    "build",
    "args",
    "resolved",
    "run_release",
    "simulator"
  ],
  "properties": {
    "build": {
      "$ref": "#/definitions/build"
    },
    "args": {
      "description": "Every classified vLLM setting, sorted by arg.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/arg"
      }
    },
    "resolved": {
      "description": "Engine outcomes compared from both sides, sorted by quantity. Never passed to BLIS.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/resolved"
      }
    },
    "replay": {
      "$ref": "#/definitions/replay"
    },
    "requests": {
      "$ref": "#/definitions/requests"
    },
    "blis_kernel_provenance": {
      "description": "The kernel's own report from BLIS's Result (reports.kernel), verbatim, or null when the Result has none. Informational only.",
      "type": [
        "object",
        "null"
      ]
    },
    "grade": {
      "description": "The point's one closeness grade (design §11.3). A scored point is G1 to G4; G5 points are in not_scored.jsonl.",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4"
      ]
    },
    "substitutions": {
      "description": "Every condition that holds the point below G1, each named, sorted by kind then subject (COV-4). Empty exactly for G1.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/substitution"
      }
    },
    "run_release": {
      "description": "The engine release the run measured, read from its recorded build and the server log's banner (design §11.2); null for a nightly or custom build.",
      "type": [
        "string",
        "null"
      ]
    },
    "simulator": {
      "$ref": "#/definitions/simulator"
    }
  },
  "definitions": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "commit",
        "source",
        "ref",
        "distance",
        "match"
      ],
      "properties": {
        "image": {
          "type": "string"
        },
        "commit": {
          "description": "Full 40-char vllm-project/vllm SHA, or null when unresolvable.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "source": {
          "enum": [
            "image_label",
            "label_by_tag",
            "server_log_banner",
            "image_tag",
            "release_tag",
            null
          ]
        },
        "ref": {
          "description": "VLLM_REF, e.g. v0.31.0.",
          "type": "string"
        },
        "distance": {
          "description": "Signed commits along main from VLLM_REF's branch point; null when the commit is unresolvable or off mainline.",
          "type": [
            "integer",
            "null"
          ]
        },
        "match": {
          "enum": [
            "exact",
            "estimated"
          ]
        },
        "why": {
          "description": "Why an estimated build isn't the one BLIS models.",
          "enum": [
            "custom_build",
            "outside_distance",
            "commit_unresolvable",
            "commit_conflict"
          ]
        }
      },
      "description": "The vLLM build that measured the point. match is exact only for an official vllm/vllm-openai(-rocm) image whose commit is on vLLM's mainline within vllm_max_distance of ref's branch point; anything else is estimated, with why. A build never stops a point from being scored.",
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "const": "estimated"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "why"
            ]
          },
          "else": {
            "not": {
              "required": [
                "why"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "why": {
                "const": "outside_distance"
              }
            },
            "required": [
              "why"
            ]
          },
          "then": {
            "properties": {
              "distance": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "arg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arg",
        "measured",
        "blis",
        "match"
      ],
      "properties": {
        "arg": {
          "type": "string"
        },
        "measured": {
          "description": "As the run recorded it. Floats are the decimal string the log printed.",
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        },
        "source": {
          "enum": [
            "launch_config",
            "args",
            "resolved_config",
            "engine_line",
            "api_row"
          ]
        },
        "blis": {
          "description": "Parsed back from the scenario / settings actually handed to BLIS.",
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        },
        "blis_field": {
          "description": "The scenario field a recorded value was copied to, where the engine block names it differently (settings.LOCATIONS).",
          "type": "string"
        },
        "match": {
          "enum": [
            "exact",
            "mapped",
            "inert",
            "approximated",
            "differs",
            "absent_in_blis",
            "unreadable",
            "conflict"
          ]
        },
        "occurrences": {
          "type": "integer",
          "minimum": 2
        },
        "values": {
          "description": "For conflict: every value found.",
          "type": "array"
        },
        "delta": {
          "type": [
            "integer",
            "string"
          ]
        },
        "ratio": {
          "description": "4 significant figures, as a string.",
          "type": "string"
        },
        "note": {
          "description": "For approximated: the field list's estimation rule that decided the value (fields.json), never composed per point.",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "const": "mapped"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "blis_field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "conflict"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "approximated"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "note"
            ]
          }
        }
      ]
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "measured",
        "blis",
        "match"
      ],
      "properties": {
        "quantity": {
          "type": "string"
        },
        "measured": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "blis": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "occurrences": {
          "type": "integer",
          "minimum": 2
        },
        "delta": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "ratio": {
          "type": [
            "string",
            "null"
          ]
        },
        "match": {
          "enum": [
            "exact",
            "differs",
            "unreadable",
            "conflict",
            "incomparable"
          ]
        },
        "reason": {
          "description": "For incomparable: why the scopes differ.",
          "type": "string"
        }
      }
    },
    "replay": {
      "description": "Agentic only: the client inputs passed to blis replay.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "client_version",
        "scenario",
        "concurrency",
        "corpus",
        "corpus_sha256",
        "seed"
      ],
      "properties": {
        "client": {
          "type": "string"
        },
        "client_version": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "replayed_as": {
          "type": "string"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "duration_s": {
          "type": "number"
        },
        "trajectory_start": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_ratio": {
              "type": "number"
            },
            "max_ratio": {
              "type": "number"
            }
          }
        },
        "corpus": {
          "type": "string"
        },
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "requests": {
      "description": "Single-turn only: how the requests the run's client sent were replayed (COV-12). The requests are the client's own draws for the point's isl, osl and concurrency, in its order. Every remaining difference between the run's client and the simulated one is named in differences; a point naming one is approximate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "start",
        "copies",
        "count",
        "differences"
      ],
      "properties": {
        "client": {
          "description": "The client whose requests were replayed.",
          "type": "string",
          "minLength": 1
        },
        "start": {
          "description": "cold: the main phase ran from an empty engine, because the run disabled prefix caching and the warm-up leaves nothing the main phase reads. primed: the main phase ran after copies of request 0 had cached its prompt, as the client's drained warm-up leaves the engine.",
          "enum": [
            "cold",
            "primed"
          ]
        },
        "copies": {
          "description": "The warm-up copies of request 0 replayed before the main phase: the deployment's dp width when primed, 0 when cold.",
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "description": "The main-phase requests replayed, 10 per unit of concurrency; the predicted means are taken over them.",
          "type": "integer",
          "minimum": 1
        },
        "differences": {
          "description": "Each difference between the run's client and the simulated one, sorted by kind, then subject.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "subject",
              "detail"
            ],
            "properties": {
              "kind": {
                "const": "client_difference"
              },
              "subject": {
                "description": "send_gap: the client's interval between one response ending and the next request, which the simulator does not model. sent_prompt_lengths: the sent prompt lengths are not verified equal to the replayed targets. client_flags: the run's job log is gone, so the client's flags are taken to be the launcher's defaults. client_release: the InferenceX commit of the run is not recorded.",
                "enum": [
                  "client_flags",
                  "client_release",
                  "send_gap",
                  "sent_prompt_lengths"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "start": {
                "const": "cold"
              }
            }
          },
          "then": {
            "properties": {
              "copies": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "start": {
                "const": "primed"
              }
            }
          },
          "then": {
            "properties": {
              "copies": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "substitution": {
      "description": "One condition that holds a point below G1 (design §11.3): a G2 condition, or the other release or build that makes it G3 or G4.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "detail"
      ],
      "properties": {
        "kind": {
          "enum": [
            "coefficient_method",
            "coefficient_range",
            "execution_mode",
            "kernel_hash",
            "value_class",
            "estimated",
            "interim_status",
            "resolved_differs",
            "client_difference",
            "later_record",
            "router_differs",
            "other_release",
            "changed_functions",
            "nightly_or_custom",
            "ported_functions_unpublished"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "record": {
          "description": "later_record only: the record the value was taken from, with its revision.",
          "type": "string",
          "minLength": 1
        },
        "date": {
          "description": "later_record only: the date of that record, YYYY-MM-DD.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "policy": {
          "description": "router_differs only: the llm-d router policy BLIS simulated in place of the run's router.",
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "description": "router_differs only: the router table's evidence for the match.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "g5_reason": {
      "description": "A reason a point is not scored: one of design §11.4's list only (COV-5). subject names the field, model, chip, router or engine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "code_not_visible",
            "router_unsupported",
            "topology_unsupported",
            "value_not_recorded",
            "field_not_modelled",
            "field_unclassified",
            "engine_unsupported",
            "not_in_catalog",
            "field_not_in_release",
            "value_conflict",
            "build_unparseable"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fault": {
      "description": "A fault of the run, not a fact about the point: the simulator refused the scenario the harness wrote, or the scenario lost a recorded value. Never a grade (CONTRACT.md, Failed points). The qualifier after ':' is a short slug.",
      "type": "string",
      "pattern": "^(blis_refused|setting_differs)(:[^\\s]+)?$"
    },
    "notScored": {
      "description": "A G5 point (design §11.4): one line of not_scored.jsonl, copied into summary.json v3's not_scored list.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "identity",
        "measured_date",
        "model",
        "hardware",
        "precision",
        "framework",
        "benchmark_type",
        "conc",
        "run_release",
        "measured",
        "grade",
        "g5_reason",
        "g5_reasons",
        "simulator"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "object"
        },
        "measured_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "model": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "benchmark_type": {
          "enum": [
            "single_turn",
            "agentic_traces"
          ]
        },
        "conc": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_release": {
          "type": [
            "string",
            "null"
          ],
          "description": "As the fidelity record's run_release."
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "grade": {
          "const": "G5"
        },
        "g5_reason": {
          "$ref": "#/definitions/g5_reason"
        },
        "g5_reasons": {
          "description": "Every G5 reason found, sorted by code then subject; g5_reason is the first by §11.4's order. The backlog counts each.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/g5_reason"
          }
        },
        "simulator": {
          "$ref": "#/definitions/simulator"
        }
      }
    },
    "failed": {
      "description": "A point whose scoring failed (CONTRACT.md, Failed points): one line of failed.jsonl. Never graded.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "identity",
        "measured_date",
        "model",
        "hardware",
        "precision",
        "framework",
        "benchmark_type",
        "conc",
        "run_release",
        "measured",
        "faults",
        "simulator"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "object"
        },
        "measured_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "model": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "benchmark_type": {
          "enum": [
            "single_turn",
            "agentic_traces"
          ]
        },
        "conc": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_release": {
          "type": [
            "string",
            "null"
          ],
          "description": "As the fidelity record's run_release."
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttft_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "tpot_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "faults": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/fault"
          }
        },
        "simulator": {
          "$ref": "#/definitions/simulator"
        }
      }
    },
    "simulator": {
      "description": "The simulator build that scored the point, the engine release it runs (blis-substrate contracts/spec/pointrecord Simulator), and the commit of the harness script that produced it (pointrecord harness_commit; design §11.7, X8). Every point of one run names the same one (COV-6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "engine",
        "harness_commit"
      ],
      "properties": {
        "build": {
          "description": "A tag vX.Y.Z with an optional pre-release suffix (a figure at a suffixed tag is experimental), or a 40-hex commit.",
          "type": "string",
          "pattern": "^(v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?|[0-9a-f]{40})$"
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "vllm"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "harness_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grade": {
            "const": "G1"
          }
        },
        "required": [
          "grade"
        ]
      },
      "then": {
        "properties": {
          "substitutions": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "substitutions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "grade": {
            "enum": [
              "G3",
              "G4"
            ]
          }
        },
        "required": [
          "grade"
        ]
      },
      "then": {
        "properties": {
          "substitutions": {
            "contains": {
              "properties": {
                "kind": {
                  "enum": [
                    "other_release",
                    "changed_functions",
                    "nightly_or_custom",
                    "ported_functions_unpublished"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "substitutions": {
            "items": {
              "properties": {
                "kind": {
                  "enum": [
                    "coefficient_method",
                    "coefficient_range",
                    "execution_mode",
                    "kernel_hash",
                    "value_class",
                    "estimated",
                    "interim_status",
                    "resolved_differs",
                    "client_difference",
                    "later_record"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "requests"
        ],
        "properties": {
          "requests": {
            "properties": {
              "differences": {
                "minItems": 1
              }
            },
            "required": [
              "differences"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "grade": {
            "not": {
              "const": "G1"
            }
          }
        }
      }
    }
  ]
}
