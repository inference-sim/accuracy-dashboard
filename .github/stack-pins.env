# The upstream builds the `simulator` job of checks.yml tests against. Each value is a 40-hex commit or a release
# tag; the job fetches either. This file is outside the scorer's files (harness/, orchestrator/, schemas/,
# requirements-ci.txt: orchestrator/baseline/test_contracts_current.py), so moving a pin from a commit to the
# release tag at that commit's content does not make a committed contract stale.
# The baseline rescore passes --sim v0.16.0 and does not read this file.

# inference-sim: the combined pull request of its stack (branch m2/combined-layers). Replace by its release tag
# once that is cut.
SIM_REF=a8bc3085a7c91c50a1d92862943a695c04adfe11
# blis-substrate: the release the point-record, router-bound and ledger tests read. The tag v0.14.0 names commit
# 965b05834c47882bc0f9f1a960c90327a756ef3d (docs/m2/h200-v033/pins.env keeps that commit: freeze_rows checks a checkout's commit).
SUBSTRATE_REF=v0.14.0
# llm-d-router fork: the commit that publishes reference-configs/ (its pull request 9).
ROUTER_REF=2a886db5d1be70aa2ae18a7dbed81f5e1cdbd1f8
