# The upstream builds the `simulator` job of checks.yml tests against. Each value is a 40-hex commit or a release
# tag; the job fetches either. This file is outside the scorer's files (harness/, orchestrator/, schemas/,
# requirements-ci.txt: orchestrator/baseline/test_contracts_current.py), so moving a pin from a commit to the
# release tag at that commit's content does not make a committed contract stale.
# The baseline rescore passes --sim v0.16.0 and does not read this file.

# inference-sim: the release v0.18.0 (M3.0), the squash merge of its M3.0 pull request (#2137). Its tree is the approved
# head's tree, which pinned blis-substrate v0.15.0, blis-vllm v0.33.0-blis.1 and the router v1.0.0-blis.5.
SIM_REF=v0.18.0
# blis-substrate: the release v0.15.0, the release the point-record, router-bound and ledger tests read
# (docs/m2/h200-v033/pins.env keeps the v0.14.0 commit: freeze_rows checks a checkout's commit).
SUBSTRATE_REF=v0.15.0
# llm-d-router fork: the release v1.0.0-blis.5, which publishes reference-configs/ (unchanged from v1.0.0-blis.4).
ROUTER_REF=v1.0.0-blis.5
