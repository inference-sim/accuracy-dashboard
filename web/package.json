{
  "name": "accuracy-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "stage:fixture": "mkdir -p public/data/latest && cp testdata/render-fixture.summary.json public/data/latest/summary.json",
    "predev": "npm run stage:fixture",
    "dev": "vite",
    "prebuild": "node -e \"require('fs').existsSync('public/data/latest/summary.json')||(require('child_process').execSync('npm run stage:fixture'))\"",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
