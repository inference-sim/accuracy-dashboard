{
 "engine": {
  "type": "vllm"
 },
 "frontend": {
  "args": {
   "disable-retries": true,
   "policy": "consistent_hash",
   "prometheus-host": "127.0.0.1",
   "prometheus-port": 18000,
   "request-timeout-secs": 14400
  },
  "enable_multiple_frontends": false,
  "type": "vllm-router"
 },
 "model": {
  "container": "vllm/vllm-openai:nightly-dev-x86_64-cu13.0.1-20ebb28",
  "path": "hf:deepseek-ai/DeepSeek-V4-Pro-0813",
  "precision": "fp4"
 },
 "resources": {
  "gpu_type": "b300",
  "gpus_per_node": 8
 },
 "roles": {
  "agg": {
   "args": {
    "attention-config": "{\"indexer_kv_dtype\":\"mxfp4\",\"backend\":\"FLASHINFER_MLA_SPARSE_DSV4\",\"use_prefill_query_quantization\":true}",
    "block-size": 256,
    "compilation-config": "{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"cudagraph_capture_sizes\":[6,7,12,14,18,21,24,28,30,35,36,42,48,49,54,56,60,63,66,70,72,77,78,84,90,91,96,98,102,105,108,112,114,119,120,126,132,133,138,140,144,147,150,154,156,161,162,168,174,175,180,182,186,189,192,196,203,210,217,224]}",
    "data-parallel-size": 8,
    "disable-uvicorn-access-log": true,
    "enable-auto-tool-choice": true,
    "enable-ep-weight-filter": true,
    "enable-expert-parallel": true,
    "gpu-memory-utilization": 0.92,
    "kv-cache-dtype": "fp8",
    "kv-cache-memory-bytes": 105000000000,
    "kv-transfer-config": "{\"kv_connector\":\"SimpleCPUOffloadConnector\",\"kv_role\":\"kv_both\",\"kv_connector_extra_config\":{\"cpu_bytes_to_use_per_rank\":356125000000,\"enable_cross_layers_blocks\":\"true\",\"lazy_offload\":false}}",
    "long-prefill-token-threshold": 512,
    "max-model-len": 1048576,
    "max-num-batched-tokens": 8416,
    "max-num-seqs": 32,
    "moe-backend": "deep_gemm_amxf4_mega_moe",
    "no-disable-hybrid-kv-cache-manager": true,
    "no-enable-flashinfer-autotune": true,
    "numa-bind": true,
    "prefill-schedule-interval": 16,
    "reasoning-parser": "deepseek_v4",
    "served-model-name": "deepseek-ai/DeepSeek-V4-Pro-0813",
    "speculative-config": "{\"method\": \"dspark\", \"num_speculative_tokens\": 6, \"draft_sample_method\": \"probabilistic\", \"rejection_sample_method\": \"synthetic\", \"synthetic_acceptance_length\": 3.77}",
    "tensor-parallel-size": 1,
    "tokenizer-mode": "deepseek_v4",
    "tool-call-parser": "deepseek_v4",
    "trust-remote-code": true
   },
   "env": {
    "NCCL_NVLS_ENABLE": "1",
    "PYTHONHASHSEED": "42",
    "PYTHONNOUSERSITE": "1",
    "PYTORCH_ALLOC_CONF": "expandable_segments:True",
    "TORCH_CUDA_ARCH_LIST": "10.0",
    "VLLM_DSV4_MEGA_FP8_COMBINE": "1",
    "VLLM_ENGINE_READY_TIMEOUT_S": "7200",
    "VLLM_FLOAT32_MATMUL_PRECISION": "high",
    "VLLM_PREFIX_CACHE_RETENTION_INTERVAL": "32768",
    "VLLM_USE_RUST_FRONTEND": "1",
    "VLLM_USE_V2_MODEL_RUNNER": "1"
   },
   "gpus": 8,
   "nodes": 1,
   "workers": 1
  }
 }
}